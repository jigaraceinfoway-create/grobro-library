# --- Database (Turso / libSQL) ---
# For LOCAL development you can use a local file (no Turso account needed):
#   TURSO_DATABASE_URL=file:local-dev.db
# For PRODUCTION on Vercel, use your Turso database URL + auth token:
#   TURSO_DATABASE_URL=libsql://your-db-name-yourorg.turso.io
#   TURSO_AUTH_TOKEN=your-turso-auth-token
TURSO_DATABASE_URL=file:local-dev.db
TURSO_AUTH_TOKEN=

# --- Auth ---
# Secret used to sign login tokens (JWT). Use a long random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional: how long a login stays valid (default 7d)
JWT_EXPIRES_IN=7d
